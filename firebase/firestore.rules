rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function teamMember() {
      // Thay bằng UID thật từ Authentication > Users, không phải email.
      return request.auth != null && request.auth.uid in [
        'Fnt4HED0BTcFrAB88zMXduCUzIu2'
      ];
    }

    match /rooms/{roomId} {
      function validRoom() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'status', 'price', 'deposit', 'area',
          'people', 'billingDay', 'zone', 'description'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.status in ['Trống', 'Đang có người', 'Đang sửa']
          && d.price is int && d.price > 0
          && d.deposit is int && d.deposit >= 0
          && d.area is number && d.area > 0
          && d.people is int && d.people >= 0
          && ((d.status == 'Đang có người' && d.people > 0)
            || (d.status != 'Đang có người' && d.people == 0))
          && d.billingDay is string
          && d.billingDay.matches('^(0?[1-9]|[12][0-9]|3[01]) hàng tháng$')
          && d.zone is string && d.description is string
          && (!('services' in d) || (d.services is list && d.services.size() <= 30))
          && (!('imageUrls' in d) || (d.imageUrls is list && d.imageUrls.size() <= 20));
      }
      allow read: if teamMember();
      allow create, update: if teamMember() && validRoom();
      // UI phần phòng chưa cung cấp nút xóa.
      allow delete: if false;
    }

    // Collection đã có của nhóm: chỉ tài khoản được cấp quyền truy cập.
    // Chưa thêm kiểm tra cấu trúc hợp đồng trong phạm vi phần phòng.
    match /contracts/{contractId} {
      allow read, write: if teamMember();
    }
  }
}
