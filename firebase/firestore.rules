rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function manager() {
      return signedIn()
        && exists(/databases/$(database)/documents/managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.enabled == true;
    }

    function owns(data) {
      return manager() && (data.ownerId == request.auth.uid || data.get('ownerId', '') == request.auth.uid);
    }

    function createsOwned() {
      return manager()
        && (request.resource.data.ownerId == request.auth.uid || request.resource.data.get('ownerId', '') == request.auth.uid);
    }

    function updatesOwned() {
      return owns(resource.data)
        && (request.resource.data.ownerId == request.auth.uid || request.resource.data.get('ownerId', '') == request.auth.uid);
    }

    function tenantEmailMatches(data) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && (data.email == request.auth.token.email || data.get('email', '') == request.auth.token.email);
    }

    function hasTenantSession() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function tenantMapping() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function tenantPortalSession() {
      return hasTenantSession()
        && tenantMapping().tenantId is string
        && tenantMapping().ownerId is string
        && tenantMapping().roomId is string
        && exists(/databases/$(database)/documents/tenants/$(tenantMapping().tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantMapping().tenantId)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/tenants/$(tenantMapping().tenantId)).data.archived != true
        && get(/databases/$(database)/documents/tenants/$(tenantMapping().tenantId)).data.ownerId == tenantMapping().ownerId
        && get(/databases/$(database)/documents/tenants/$(tenantMapping().tenantId)).data.roomId == tenantMapping().roomId;
    }

    function tenantRoomAccess(data, roomId) {
      return data != null
        && tenantPortalSession()
        && (data.ownerId == tenantMapping().ownerId || data.get('ownerId', '') == tenantMapping().ownerId)
        && (roomId == tenantMapping().roomId || data.roomId == tenantMapping().roomId || data.get('roomId', '') == tenantMapping().roomId);
    }

    function tenantServiceAccess(data, serviceId) {
      return data != null
        && tenantPortalSession()
        && (data.ownerId == tenantMapping().ownerId || data.get('ownerId', '') == tenantMapping().ownerId)
        && exists(/databases/$(database)/documents/rooms/$(tenantMapping().roomId))
        && get(/databases/$(database)/documents/rooms/$(tenantMapping().roomId)).data.get('serviceIds', []).hasAny([serviceId]);
    }

    function validTenantMapping(data) {
      let tenantPath = /databases/$(database)/documents/tenants/$(data.tenantId);
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && data.keys().hasOnly(['tenantId', 'ownerId', 'roomId'])
        && data.tenantId is string
        && data.ownerId is string
        && data.roomId is string
        && (
          (existsAfter(tenantPath)
            && getAfter(tenantPath).data.authUid == request.auth.uid
            && getAfter(tenantPath).data.email == request.auth.token.email
            && getAfter(tenantPath).data.archived != true
            && getAfter(tenantPath).data.ownerId == data.ownerId
            && getAfter(tenantPath).data.roomId == data.roomId)
          ||
          (exists(tenantPath)
            && get(tenantPath).data.authUid == request.auth.uid
            && get(tenantPath).data.email == request.auth.token.email
            && get(tenantPath).data.archived != true
            && get(tenantPath).data.ownerId == data.ownerId
            && get(tenantPath).data.roomId == data.roomId)
        );
    }

    match /managers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /rooms/{id} {
      allow get: if (manager() && resource == null)
        || owns(resource.data)
        || tenantRoomAccess(resource.data, id);
      allow list: if owns(resource.data);
      allow create: if createsOwned()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.condition in ['Tốt', 'Đang sửa']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.deposit is number
        && request.resource.data.deposit >= 0
        && request.resource.data.capacity is number
        && request.resource.data.capacity >= 1
        && request.resource.data.serviceIds is list
        && request.resource.data.serviceIds.size() <= 30;
      allow update: if updatesOwned()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.condition in ['Tốt', 'Đang sửa']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.deposit is number
        && request.resource.data.deposit >= 0
        && request.resource.data.capacity is number
        && request.resource.data.capacity >= 1
        && request.resource.data.serviceIds is list
        && request.resource.data.serviceIds.size() <= 30;
    }

    match /tenants/{id} {
      allow get: if (manager() && resource == null)
        || owns(resource.data)
        || tenantEmailMatches(resource.data)
        || (signedIn()
          && request.auth.token.email_verified == true
          && (resource.data.authUid == request.auth.uid || resource.data.get('authUid', '') == request.auth.uid));
      allow list: if owns(resource.data)
        || (signedIn()
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && (resource.data.email == request.auth.token.email || resource.data.get('email', '') == request.auth.token.email))
        || (signedIn()
          && request.auth.token.email_verified == true
          && (resource.data.authUid == request.auth.uid || resource.data.get('authUid', '') == request.auth.uid));
      allow create: if createsOwned();
      allow update: if updatesOwned() || (
        tenantEmailMatches(resource.data)
        && resource.data.archived != true
        && resource.data.roomId is string
        && resource.data.roomId.size() > 0
        && (resource.data.get('authUid', '') == ''
          || resource.data.authUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['authUid', 'updatedAt'])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.tenantId == id
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.ownerId == resource.data.ownerId
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.roomId == resource.data.roomId
      );
    }

    match /services/{id} {
      allow get: if (manager() && resource == null)
        || owns(resource.data)
        || tenantServiceAccess(resource.data, id);
      allow list: if owns(resource.data);
      allow create: if createsOwned()
        && request.resource.data.id == id
        && request.resource.data.mode in ['meter', 'room', 'person']
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow update: if updatesOwned()
        && request.resource.data.id == id
        && request.resource.data.mode in ['meter', 'room', 'person']
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }

    match /meters/{id} {
      allow get: if (manager() && resource == null)
        || owns(resource.data)
        || tenantRoomAccess(resource.data, resource.data.get('roomId', ''));
      allow list: if owns(resource.data)
        || tenantRoomAccess(resource.data, resource.data.roomId);
      allow create: if createsOwned()
        && request.resource.data.previous is number
        && request.resource.data.previous >= 0
        && request.resource.data.current is number
        && request.resource.data.current >= request.resource.data.previous;
      allow update: if updatesOwned()
        && request.resource.data.previous is number
        && request.resource.data.previous >= 0
        && request.resource.data.current is number
        && request.resource.data.current >= request.resource.data.previous;
    }

    match /contracts/{id} {
      allow get: if (manager() && resource == null)
        || owns(resource.data)
        || (tenantRoomAccess(resource.data, resource.data.get('roomId', ''))
          && (
            resource.data.get('tenantId', '') == tenantMapping().tenantId
            || resource.data.get('tenantIds', []).hasAny([tenantMapping().tenantId])
          ));
      allow list: if owns(resource.data)
        || (tenantRoomAccess(resource.data, resource.data.roomId)
          && (
            resource.data.tenantId == tenantMapping().tenantId
            || resource.data.get('tenantId', '') == tenantMapping().tenantId
            || resource.data.tenantIds.hasAny([tenantMapping().tenantId])
            || resource.data.get('tenantIds', []).hasAny([tenantMapping().tenantId])
          ));
      allow create: if createsOwned()
        && request.resource.data.rent is number
        && request.resource.data.rent > 0
        && request.resource.data.deposit is number
        && request.resource.data.deposit >= 0;
      allow update: if updatesOwned()
        && request.resource.data.rent is number
        && request.resource.data.rent > 0
        && request.resource.data.deposit is number
        && request.resource.data.deposit >= 0;
    }

    match /extras/{id} {
      allow get: if (manager() && resource == null) || owns(resource.data);
      allow list: if owns(resource.data);
      allow delete: if owns(resource.data);
      allow create: if createsOwned()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
      allow update: if updatesOwned()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0;
    }

    match /maintenance/{id} {
      allow get: if (manager() && resource == null)
        || owns(resource.data)
        || (tenantRoomAccess(
              resource.data,
              resource.data.get('roomId', '')
            )
            && (resource.data.tenantId == tenantMapping().tenantId
              || resource.data.get('tenantId', '') == tenantMapping().tenantId));
      allow list: if owns(resource.data)
        || (tenantRoomAccess(resource.data, resource.data.roomId)
          && (resource.data.tenantId == tenantMapping().tenantId
            || resource.data.get('tenantId', '') == tenantMapping().tenantId));
      allow update: if updatesOwned();
      allow create: if createsOwned() || (
        tenantPortalSession()
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'roomId',
          'tenantId',
          'requesterUid',
          'roomName',
          'tenantName',
          'title',
          'description',
          'issueType',
          'priority',
          'status',
          'cost',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerId == tenantMapping().ownerId
        && request.resource.data.roomId == tenantMapping().roomId
        && request.resource.data.tenantId == tenantMapping().tenantId
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000
        && request.resource.data.issueType in ['Thiết bị', 'Điện / Nước', 'Nội thất', 'Khác']
        && request.resource.data.priority in ['Thấp', 'Trung bình', 'Cao']
        && request.resource.data.status == 'new'
        && request.resource.data.cost == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
      );
    }

    match /settings/{id} {
      allow get: if (manager() && resource == null && id == request.auth.uid)
        || (owns(resource.data) && id == request.auth.uid)
        || (hasTenantSession()
          && tenantPortalSession()
          && id == tenantMapping().ownerId);
      allow list: if owns(resource.data) && id == request.auth.uid;
      allow create: if createsOwned() && id == request.auth.uid;
      allow update: if updatesOwned() && id == request.auth.uid;
    }

    match /system/revision {
      allow read, create, update: if manager();
    }

    match /invoices/{id} {
      allow get: if (manager() && resource == null)
        || owns(resource.data)
        || (signedIn() && resource.data.get('recipientUid', '') == request.auth.uid);
      allow list: if owns(resource.data)
        || (signedIn() && resource.data.get('recipientUid', '') == request.auth.uid);

      allow create: if createsOwned()
        && request.resource.data.status == 'unpaid'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0;

      allow update: if (
        updatesOwned()
        && request.resource.data.status in ['unpaid', 'reported', 'paid', 'void']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'total',
          'lines',
          'rent',
          'contractId',
          'period',
          'meterPeriod',
          'roomId',
          'tenantId',
          'dueDate',
          'issueDate',
          'ownerId'
        ])
      ) || (
        signedIn()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.status == 'unpaid'
        && request.resource.data.status == 'reported'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reportedAt',
          'paymentNote',
          'updatedAt'
        ])
        && request.resource.data.reportedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.paymentNote is string
        && request.resource.data.paymentNote.size() <= 4000
      );
    }

    match /notifications/{id} {
      function ownPaymentReport() {
        let n = request.resource.data;
        let before = get(
          /databases/$(database)/documents/invoices/$(n.invoiceId)
        ).data;
        let after = getAfter(
          /databases/$(database)/documents/invoices/$(n.invoiceId)
        ).data;

        return signedIn()
          && n.keys().hasOnly([
            'ownerId',
            'title',
            'body',
            'audience',
            'invoiceId',
            'createdAt',
            'delivery'
          ])
          && id == 'reported_' + n.invoiceId
          && n.audience == 'managers'
          && n.ownerId == before.ownerId
          && after.ownerId == before.ownerId
          && n.title == 'Người thuê báo đã chuyển tiền'
          && n.body is string
          && n.body.size() <= 4000
          && n.delivery == 'in_app'
          && n.createdAt == request.time
          && before.recipientUid == request.auth.uid
          && before.status == 'unpaid'
          && after.recipientUid == request.auth.uid
          && after.status == 'reported';
      }

      allow read: if (
        owns(resource.data) && resource.data.audience == 'managers'
      ) || (
        signedIn() && resource.data.get('recipientUid', '') == request.auth.uid
      );

      allow create: if (
        createsOwned()
        && request.resource.data.audience in ['managers', 'tenant']
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.createdAt == request.time
      ) || ownPaymentReport();

      allow update: if updatesOwned()
        && request.resource.data.audience in ['managers', 'tenant']
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.createdAt == request.time;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validTenantMapping(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data == request.resource.data
        && validTenantMapping(request.resource.data);

      match /reads/{noticeId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }
    }
  }
}
