rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kiểm tra người dùng đã đăng nhập Firebase Authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Quản lý phòng trọ
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Quản lý hóa đơn (hỗ trợ cả Invoices viết hoa và invoices viết thường)
    match /Invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Quản lý người thuê
    match /tenants/{tenantId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Quản lý hợp đồng
    match /contracts/{contractId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Quản lý chỉ số điện nước
    match /meters/{meterId} {
      allow read, write: if isAuthenticated();
    }
    match /meter_readings/{readingId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Dịch vụ & sự cố sửa chữa
    match /services/{serviceId} {
      allow read, write: if isAuthenticated();
    }
    match /maintenance_requests/{reqId} {
      allow read, write: if isAuthenticated();
    }

    // Cho phép đọc/ghi cho tất cả các collection khi người dùng đã đăng nhập
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
